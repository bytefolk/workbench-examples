{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["characters", "assets"],
  "definitions": {
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "allowedUsages"],
      "properties": {
        "status": { "enum": ["approved", "pending", "restricted"] },
        "allowedUsages": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["internal-demo", "marketing"] }
        }
      }
    }
  },
  "properties": {
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "rights"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "rights": { "$ref": "#/definitions/rights" }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "type",
          "characterId",
          "emotion",
          "version",
          "status",
          "rights",
          "tags",
          "source"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "type": { "enum": ["image", "video", "product"] },
          "characterId": { "type": ["string", "null"] },
          "emotion": {
            "enum": ["neutral", "happy", "angry", "sad", "joyful", null]
          },
          "version": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["active", "archived"] },
          "rights": { "$ref": "#/definitions/rights" },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
