# Paste the COMPLETE key copied from https://open.higgsfield.ai/api-keys.
# Do not prefix with VITE_: these credentials must remain server-only.
HF_API_KEY=
HF_ENABLE_REAL=false
API_PORT=8788

# Optional Alibaba Cloud Qwen semantic retrieval. Leave blank for free local rules.
DASHSCOPE_API_KEY=
# Copy the OpenAI-compatible base URL for your workspace and region from the console.
QWEN_BASE_URL=
QWEN_MODEL=qwen-plus
