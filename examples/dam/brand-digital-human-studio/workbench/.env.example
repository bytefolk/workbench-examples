# Paste the COMPLETE key copied from https://open.higgsfield.ai/api-keys.
# Do not prefix with VITE_: these credentials must remain server-only.
HF_API_KEY=
HF_ENABLE_REAL=false
API_PORT=8788

# Xiaoyunque: use npm run xyq:install and npm run xyq:login on this computer.
# Browser authorization is stored by the official CLI, never in the frontend.
XYQ_ENABLE_REAL=false
# Optional only for a deployed server; leave empty when using browser login.
XYQ_ACCESS_KEY=
# Optional absolute path if you already installed the native official CLI.
XYQ_CLI_PATH=

# Optional Alibaba Cloud Qwen semantic retrieval. Leave blank for free local rules.
DASHSCOPE_API_KEY=
# Copy the OpenAI-compatible base URL for your workspace and region from the console.
QWEN_BASE_URL=
QWEN_MODEL=qwen-plus

# Optional Wan settings; page configuration is preferred.
# dashscope: Beijing Bailian Key (not Coding/Token Plan).
# gateway: use that video gateway's own Key, never a Bailian Key.
WAN_PROTOCOL=dashscope
# Blank uses protocol default. Gateway default: https://ai.amaxsmp.com/v1
WAN_BASE_URL=
# Optional actual gateway model name/alias; confirm in your account console.
WAN_GATEWAY_MODEL_ID=
WAN_API_KEY=
WAN_WORKSPACE_ID=
WAN_ENABLE_REAL=false

# Optional Seedance video service. Prefer configuring its Key in the page.
# Separate from the Alibaba Cloud Key used for Wan and cloned voices.
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ai.amaxsmp.com/v1
SEEDANCE_ENABLE_REAL=false
