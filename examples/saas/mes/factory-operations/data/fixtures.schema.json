{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspaceName", "reports", "visits"],
  "properties": {
    "workspaceName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "contractNumber",
          "materialNumber",
          "station",
          "reason",
          "quantity",
          "assetIds"
        ],
        "properties": {
          "kind": { "enum": ["broken_needle", "consumable"] },
          "contractNumber": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "materialNumber": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "station": { "type": "string", "minLength": 1, "maxLength": 120 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 100000 },
          "assetIds": {
            "type": "array",
            "maxItems": 10,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "visits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "customer",
          "visitedAt",
          "summary",
          "issues",
          "nextStep",
          "followUpDate"
        ],
        "properties": {
          "customer": { "type": "string", "minLength": 1, "maxLength": 200 },
          "visitedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
          },
          "summary": { "type": "string", "minLength": 1, "maxLength": 5000 },
          "issues": { "type": "string", "maxLength": 5000 },
          "nextStep": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "followUpDate": {
            "type": ["string", "null"],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    }
  }
}
