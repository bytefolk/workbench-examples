{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "title",
    "summary",
    "domain",
    "tags",
    "status",
    "source",
    "dataMode",
    "deliverables",
    "runtime",
    "capabilities",
    "serviceModel"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "status": {
      "enum": ["proposal", "specified", "prototype", "integrated", "verified"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "kind", "summary", "customerConfirmed"],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "kind": {
          "enum": ["business-discussion", "research", "customer-approved"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "customerConfirmed": {
          "type": "boolean"
        }
      }
    },
    "dataMode": {
      "enum": ["synthetic", "anonymized", "mixed"]
    },
    "deliverables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overview",
        "requirements",
        "workflows",
        "dataModel",
        "integrations",
        "acceptance",
        "evidence"
      ],
      "properties": {
        "overview": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "string",
          "minLength": 1
        },
        "workflows": {
          "type": "string",
          "minLength": 1
        },
        "dataModel": {
          "type": "string",
          "minLength": 1
        },
        "integrations": {
          "type": "string",
          "minLength": 1
        },
        "acceptance": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "command", "entry", "reset"],
      "properties": {
        "mode": {
          "enum": ["none", "static-local", "application"]
        },
        "command": {
          "type": "string"
        },
        "entry": {
          "type": "string"
        },
        "reset": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "mode", "description"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": ["local", "mock", "unavailable", "connected"]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "serviceModel": {
      "enum": ["saas", "paas", "iaas"]
    }
  }
}
