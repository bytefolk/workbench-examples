{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "domains"],
  "properties": {
    "version": {
      "const": 3
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "summary", "serviceModel", "groupId"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "serviceModel": {
            "enum": ["saas", "paas", "iaas"]
          },
          "groupId": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "type": "string"
          }
        }
      }
    }
  }
}
